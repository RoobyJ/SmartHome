{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "CustomHostName": null,
  "HostingOptions": {
    "PathBase": null,
    "ReverseProxyAddress": null,
    "UseHttpsRedirection": true,
    "UseHsts": true,
    "UseHttpLogging": false
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{*any}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": {
            "Address": null
          }
        }
      }
    }
  }
}
